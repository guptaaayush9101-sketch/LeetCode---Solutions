1979. Find Greatest Common Divisor of Array

class Solution {
    public int findGCD(int[] nums) {
        int n = nums.length;
        Arrays.sort(nums);
        return gcd(nums[0] , nums[n-1]);

    }
    public int gcd(int a , int b){
        while(a>0 && b>0){
            if(a > b ){
                a = a%b;
            } 
            else{
                b = b%a;
            }
    }
            if(a == 0){
                return b;
            }else{
                return a;
            }
            
        }
       
    }
