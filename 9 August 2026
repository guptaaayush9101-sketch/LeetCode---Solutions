4014. Minimum Total Price After Applying Discounts

class Solution {
    public double minPrice(int[] prices, int[] discounts) {
        double sum = 0;
        Arrays.sort(prices);
        Arrays.sort(discounts);
        int n = prices.length;
        int m = discounts.length;
        int i = n-1;
        int j = m-1;
        while(j >= 0 && i>=0){
            int p = prices[i];
            int d = discounts[j];
            double curr = (p * (100.0 - d)) / 100.0;
            sum += curr;
            i--;
            j--;
        }
        while(i>=0){
            sum += prices[i];
            i--;
        }
        return sum;
    }
}
