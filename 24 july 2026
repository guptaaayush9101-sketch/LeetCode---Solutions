213. House Robber II

class Solution {
    public int rob(int[] nums) {
        int n = nums.length;
        int dp1[] = new int[n+1];
        Arrays.fill(dp1,-1);
        int dp2[] = new int[n+1];
        Arrays.fill(dp2,-1);
        if(nums.length == 1){
            return nums[0];
        }
        int a = solve(1,nums,dp1);
        int b = solve2(0,nums,dp2);
        return Math.max(a,b);
    }
    public int solve(int i,int nums[],int dp1[]){
        int n = nums.length;
        if(i>=n){
            return 0;
        }
        if(dp1[i] != -1){
            return dp1[i];
        }
        int take = nums[i] + solve(i+2,nums,dp1);
        int nottake = solve(i+1,nums,dp1);

        dp1[i] =  Math.max(take,nottake);
        return dp1[i];
    }
    public int solve2(int i,int nums[],int dp2[]){
        int n = nums.length;
        if(i>=n-1){
            return 0;
        }
        if(dp2[i] != -1){
            return dp2[i];
        }
        int take = nums[i] + solve2(i+2,nums,dp2);
        int nottake = solve2(i+1,nums,dp2);

        dp2[i] =  Math.max(take,nottake);
        return dp2[i];
    }
}
