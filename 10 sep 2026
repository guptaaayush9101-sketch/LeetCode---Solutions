1482. Minimum Number of Days to Make m Bouquets

class Solution {
    public int minDays(int[] bloomDay, int m, int k) {
        
        int n = bloomDay.length;
        int ans = Integer.MAX_VALUE;
        int count = 0;
        int noofbloom = 0;
         if ((long) m * k > n) {
            return -1;
        }
        for(int i=0;i<n;i++){
            count = 0;
            int rep = bloomDay[i];
            noofbloom = 0;
            for(int j=0;j<n;j++){
                
                if(bloomDay[j] <= rep){
                    count++;
                    if(count == k){
                        noofbloom++;
                        count = 0;
                    }
                }
                
                else {
                    count = 0;
                }
            } 
            if(noofbloom >= m){
                ans = Math.min(rep,ans);
            } 
        }
        return ans;
    }
}
