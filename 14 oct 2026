class Solution {
    int ans;
    int count = 0;
    public int kthSmallest(TreeNode root, int k) {
        func(root,k);
        return ans;
    }
    public void func(TreeNode root,int k){
        if(root == null){
            return ;
        }
        func(root.left,k);
        count++;
        if(count == k){
            ans = root.val;
            return;
        }
        func(root.right,k);
        return;
    }
}
