Aggressive Cows

class Solution {
    public int aggressiveCows(int[] arr, int k) {
        // code here
        Arrays.sort(arr);
        int n = arr.length;
        int maxdist = arr[n-1]-arr[0];
        for(int i=1;i<=maxdist;i++){
            if(canPlace(arr,k,i)){
                continue;
            }
            else{
                return i-1;
            }
        }
        return maxdist;
    }
    public boolean canPlace(int[] arr , int k, int dist){
        int n = arr.length;
        int cows = 1;
        int last = arr[0];
        for(int i=1;i<n;i++){
            if(arr[i] - last >= dist){
                cows++;
                last = arr[i];
            }
            if(cows == k){
                return true;
            }
        }
        return false;
    }
}
