69. Sqrt(x)

class Solution {
    public int mySqrt(int x) {
        int n = 46340;
        int arr1[] = new int[n+1];
        int arr2[] = new int[n+1];
        for(int i=0;i<arr1.length;i++){
            arr1[i] = i*i;
        }
        for(int i=0;i<arr2.length;i++){
            arr2[i] = i;
        }
        for(int i=0;i<arr1.length;i++){
            if(arr1[i] == x){
                return arr2[i];
            }
        }
        for(int i=0;i<arr1.length;i++){
            if(arr1[i] > x){
                return arr2[i-1];
            }
        }
        return arr2[n];
    }
}
