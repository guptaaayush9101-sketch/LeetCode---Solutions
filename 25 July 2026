213. House Robber II

class Solution {
    public int rob(int[] nums) {
        int n = nums.length;

        if (nums.length == 1) {
            return nums[0];
        }
        int a = solve1(nums);
        int b = solve2(nums);
        return Math.max(a, b);
    }

    public int solve1(int nums[]) {
        int n = nums.length;
        int dp1[] = new int[n + 2];

        dp1[n] = 0;
        dp1[n + 1] = 0;

        for (int i = n - 1; i >= 1; i--) {
            int take = nums[i] + dp1[i + 2];
            int nottake = dp1[i + 1];

            dp1[i] = Math.max(take, nottake);
        }

        return dp1[1];
    }

    public int solve2(int nums[]) {
        int n = nums.length;
        int dp2[] = new int[n + 2];
        dp2[n] = 0;
        dp2[n + 1] = 0;

        for (int i = n - 2; i >= 0; i--) {
            int take = nums[i] + dp2[i + 2];
            int nottake = dp2[i + 1];

            dp2[i] = Math.max(take, nottake);
        }

        return dp2[0];
    }
}
