        int sum = 1;
        for(int i=0;i<1000;i++){
            //kya un dono digits ka sum s ke barabar hai??
            if( == s){
                sum = i;
            }
            
        }
        return sum;
    }
    public int digitSum(int n , int s){
        int sum = 0;
        for(int i=0;i<1000;i++){
            digit = i%10;
            sum += digit;
            i = i/10;
        }
    }
}
