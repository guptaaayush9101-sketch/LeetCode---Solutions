4052. Cyclically Shift Rows and Columns

class Solution {
    public int[][] cyclicShift(int n, int[][] grid, int[] rowShift, int[] colShift) {
        
        for(int i=0;i<n;i++){
            int arr[] = new int[n];
            for(int j=0;j<n;j++){
                arr[(j-rowShift[i]+n)%n] = grid[i][j];
            }
            grid[i] = arr;
        }
        
        for(int j=0;j<n;j++){
            int arr[] = new int[n];
            for(int i=0;i<n;i++){
                arr[(i-colShift[j]+n)%n] = grid[i][j];
            }
            for(int i=0;i<n;i++){
                grid[i][j] = arr[i];
            }
        }
        return grid;
    }
}
