189. Rotate Array

class Solution {
    public void rotate(int[] nums, int k) {
        ArrayList<Integer>list1 = new ArrayList<>();
        ArrayList<Integer>list2 = new ArrayList<>();
        
        int n = nums.length;
        k = k%n;
        for(int i=n-k;i<n;i++){
            list1.add(nums[i]);
        }
        for(int i=0;i<n-k;i++){
            list2.add(nums[i]);
        }

        int l = 0;
        for(int i=0;i<list1.size();i++){
            nums[l] = list1.get(i);
            l++;
        }

        for(int i=0;i<list2.size();i++){
            nums[l] = list2.get(i);
            l++;
        }
        
    }
}
