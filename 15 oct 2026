class Solution {
    public boolean isValidBST(TreeNode root) {
        return func(root,Long.MIN_VALUE,Long.MAX_VALUE);
    }
    public boolean func(TreeNode root,long min,long max){
        if(root == null){
            return true;
        }
        if(root.val <= min || root.val >= max){
            return false;
        }
        boolean left = func(root.left,min,root.val);
        boolean right = func(root.right,root.val,max);
        if(left && right){
            return true;
        }
        else{
            return false;
        }
    }
}
