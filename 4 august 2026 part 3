448. Find All Numbers Disappeared in an Array

class Solution {
    public List<Integer> findDisappearedNumbers(int[] nums) {
        ArrayList<Integer>anslist = new ArrayList<>();
        HashSet<Integer>set = new HashSet<>();
        int n = nums.length;
        for(int i=0;i<n;i++){
            set.add(nums[i]);
        }
        
        for(int i=0;i<n;i++){
            if(!set.contains(i+1)){
                anslist.add(i+1);
            }
        }
        return anslist;
    }
}
