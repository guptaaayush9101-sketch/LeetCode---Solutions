class Solution {
    public int kthSmallest(TreeNode root, int k) {
        if(root == null){
            return k;
        }
        ArrayList<Integer> list = new ArrayList<>();
        func(root, list);
        Collections.sort(list);

        return list.get(k-1);

    }

    public void func(TreeNode root, ArrayList<Integer> list) {
        if (root == null) {
            return;
        }
        list.add(root.val);
        func(root.left, list);
        func(root.right, list);
    }
}
