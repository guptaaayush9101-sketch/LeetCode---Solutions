Allocate Minimum Pages

class Solution {
    public int findPages(int[] arr, int k) {

        int n = arr.length;

        if(k > n){
            return -1;
        }

        long sum = 0;

        for(int i = 0; i < n; i++){
            sum += arr[i];
        }

        long max = arr[0];

        for(int i = 0; i < n; i++){
            if(arr[i] > max){
                max = arr[i];
            }
        }

        long low = max;
        long high = sum;
        long ans = -1;

        while(low <= high){

            long mid = low + (high - low) / 2;

            if(possible(arr, mid, k)){
                ans = mid;
                high = mid - 1;
            }
            else{
                low = mid + 1;
            }
        }

        return (int) ans;
    }

    public boolean possible(int[] arr, long pages, int k){

        int n = arr.length;

        int stu = 1;
        long pagesStudent = 0;

        for(int i = 0; i < n; i++){

            if(pagesStudent + arr[i] <= pages){
                pagesStudent += arr[i];
            }
            else{
                stu++;
                pagesStudent = arr[i];
            }
        }

        return stu <= k;
    }
}
