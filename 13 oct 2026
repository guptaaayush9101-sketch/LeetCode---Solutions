class Solution {
    public TreeNode insertIntoBST(TreeNode root, int val) {
        return func(root,val);
    }
    public TreeNode func(TreeNode root, int val){
        if(root == null){
            return new TreeNode(val);
        }
        if(val > root.val){
            root.right = func(root.right,val);
            
        }
        else{
            root.left = func(root.left,val);
        }
        return root;
    }
}
