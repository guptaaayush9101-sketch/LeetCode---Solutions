48. Rotate Image

class Solution {
    public void rotate(int[][] matrix) {
        ArrayList<Integer>list = new ArrayList<>();
        ArrayList<ArrayList<Integer>> orlist = new ArrayList<>();
        int n = matrix.length;
        int m = matrix[0].length;
        int mat[][] = new int[n][m];
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                mat[i][j] = matrix[i][j];
            }
        }
        for(int i=0;i<m;i++){
            list.clear();
            for(int j=0;j<n;j++){
                list.add(mat[j][i]);
            }
            orlist.add(new ArrayList<>(list));
        }
        for(int i=0;i<orlist.size();i++){
            Collections.reverse(orlist.get(i));
        }
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < m; j++) {
                matrix[i][j] = orlist.get(i).get(j);
            }
        }
    }
}
