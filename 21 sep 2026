class Solution {
    public boolean isSameTree(TreeNode p, TreeNode q) {
        return func(p,q);
    }
    public boolean func(TreeNode p, TreeNode q){
        if(p == null && q == null){
            return true;
        }
        if(p != null && q == null){
            return false;
        }
        if(p == null && q != null){
            return false;
        }
        
        if(p.val != q.val){
            return false;
        }
        boolean left = func(p.left,q.left);
        boolean right = func(p.right,q.right);
        return left && right;
    }
}
