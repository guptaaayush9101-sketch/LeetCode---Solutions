Q2. Find All Numbers Disappeared in an Array II©leetcode

class Solution {
    public List<List<Integer>> findDisappearedNumbers(int[] nums, int lower, int upper) {
        int n = nums.length;
        Arrays.sort(nums);
        List<List<Integer>> ans = new ArrayList<>();
        int s = lower;
        for(int i : nums){
            if(i < s){
                continue;
            }
            if(i > upper){
                break;
            }
            if(i > s){
                ArrayList<Integer>list = new ArrayList<>();
                list.add(s);
                list.add(i-1);

                ans.add(list);
            }
            s = i+1;
        }
        if(s <= upper){
            ArrayList<Integer>list = new ArrayList<>();
                list.add(s);
                list.add(upper);

                ans.add(list);
        }
        return ans;
    }
}©leetcode
